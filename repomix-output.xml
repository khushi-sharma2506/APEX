<file path="frontend/style.css">
:root{
  --paper:#F5F7FA; --surface:#FFFFFF; --sunken:#EAEFF5;
  --ink:#14213D; --muted:#5A6679; --line:#DDE3EB; --line-strong:#C6CFDB;
  --brand:#1F3A68; --brand-ink:#FFFFFF; --brand-soft:#E3EAF6;
  --ok:#1F6A3C; --ok-bg:#E6F2EA; --warn:#8A5207; --warn-bg:#FBF0DB; --bad:#9E2F25; --bad-bg:#F8E6E3;
  --c1:#1F3A68; --c2:#2A7F7A; --c3:#B8791A; --c4:#7A5C99;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;height:100%;background:var(--paper);color:var(--ink);
  font:15px/1.5 "Instrument Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;-webkit-font-smoothing:antialiased}
button,input,select{font:inherit;color:inherit}
h1,h2,h3,p{margin:0}
:focus-visible{outline:2px solid var(--brand);outline-offset:2px}

/* shell */
.app{height:100%;display:grid;grid-template-columns:248px minmax(0,1fr)}
.side{border-right:1px solid var(--line);display:flex;flex-direction:column;gap:28px;padding:20px 14px;overflow:auto}
.brand{display:flex;align-items:center;gap:10px;padding:0 8px}
.mark{width:32px;height:32px;border-radius:9px;background:var(--brand);color:var(--brand-ink);display:grid;place-items:center;font-weight:700;font-size:16px}
.brand b{display:block;font-size:17px;letter-spacing:-.01em;line-height:1.1}
.brand small{display:block;color:var(--muted);font-size:12px;line-height:1.25;margin-top:2px}
.nav{display:flex;flex-direction:column;gap:2px}
.navitem{display:flex;align-items:center;gap:10px;height:40px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:var(--muted);font-weight:500;cursor:pointer;text-align:left}
.navitem:hover{background:var(--sunken);color:var(--ink)}
.navitem[aria-current="true"]{background:var(--brand-soft);color:var(--ink)}
.navitem svg{width:18px;height:18px;flex:none}
.side-foot{margin-top:auto;padding:12px;border:1px solid var(--line);border-radius:10px;color:var(--muted);font-size:13px}
.main{overflow:auto;min-width:0}
.top{position:sticky;top:0;z-index:5;display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:10px 14px;padding:12px 32px;background:var(--paper);border-bottom:1px solid var(--line)}
.top .lbl{color:var(--muted);font-size:13px;margin-right:auto}
.pals{display:flex;align-items:center;gap:8px}
.sw{width:22px;height:22px;border-radius:50%;border:2px solid var(--surface);box-shadow:0 0 0 1px var(--line-strong);cursor:pointer;padding:0}
.sw:hover{box-shadow:0 0 0 1px var(--muted)}
.sw[aria-pressed="true"]{box-shadow:0 0 0 2px var(--ink)}
#palName{font-size:13px;color:var(--muted);min-width:64px}
.page{max-width:1120px;margin:0 auto;padding:32px}
.view[hidden],.exam[hidden]{display:none}
.head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:24px}
.head h1{font-size:28px;line-height:1.15;letter-spacing:-.02em;font-weight:650}
.head p{color:var(--muted);margin-top:6px;max-width:60ch}

/* components */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 14px;border-radius:8px;border:1px solid var(--line-strong);background:var(--surface);font-weight:500;cursor:pointer;white-space:nowrap}
.btn:hover{background:var(--sunken)}
.btn.primary{background:var(--brand);border-color:var(--brand);color:var(--brand-ink)}
.btn.primary:hover{filter:brightness(1.08)}
.btn.quiet{border-color:transparent;background:transparent;color:var(--muted)}
.btn[disabled]{opacity:.5;cursor:not-allowed;filter:none}
.icon-btn{width:38px;padding:0}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px}
.pad{padding:20px}
.card h2{font-size:16px;font-weight:600;letter-spacing:-.005em}
.sub{color:var(--muted);font-size:13px}
.badge{display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:999px;font-size:12px;font-weight:600;background:var(--sunken);color:var(--muted);white-space:nowrap}
.badge.ok{background:var(--ok-bg);color:var(--ok)} .badge.warn{background:var(--warn-bg);color:var(--warn)}
.badge.bad{background:var(--bad-bg);color:var(--bad)} .badge.brand{background:var(--brand-soft);color:var(--ink)}
.input,.select{height:38px;width:100%;border:1px solid var(--line-strong);border-radius:8px;background:var(--surface);padding:0 10px}
.input::placeholder{color:var(--muted)}
.field{display:flex;flex-direction:column;gap:6px}
.field>span{font-size:13px;font-weight:500}
.seg{display:inline-flex;padding:3px;border-radius:10px;background:var(--sunken);gap:2px}
.seg button{border:0;background:transparent;height:30px;padding:0 12px;border-radius:7px;font-weight:500;color:var(--muted);cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.12)}
.switch{display:inline-flex;align-items:center;gap:10px;border:0;background:transparent;cursor:pointer;padding:0}
.switch i{width:38px;height:22px;border-radius:999px;background:var(--line-strong);position:relative;transition:background .15s}
.switch i::after{content:"";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:var(--surface);transition:transform .15s}
.switch[aria-checked="true"] i{background:var(--brand)}
.switch[aria-checked="true"] i::after{transform:translateX(16px)}
.switch[disabled]{opacity:.5;cursor:not-allowed}
.scroll{overflow-x:auto}
.tbl{width:100%;border-collapse:collapse;min-width:640px}
.tbl th{text-align:left;font-weight:500;color:var(--muted);font-size:13px;padding:10px 16px;border-bottom:1px solid var(--line);white-space:nowrap}
.tbl td{padding:14px 16px;border-bottom:1px solid var(--line);vertical-align:top}
.tbl tr:last-child td{border-bottom:0}
.clamp{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;max-width:56ch}
.num{font-variant-numeric:tabular-nums}
.empty{padding:40px 20px;text-align:center;color:var(--muted)}
dialog{border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--ink);padding:0;width:min(520px,calc(100% - 32px))}
dialog::backdrop{background:rgba(20,14,10,.5)}
.dlg-body{padding:24px}.dlg-foot{display:flex;justify-content:flex-end;gap:10px;padding:14px 24px;border-top:1px solid var(--line)}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--paper);padding:10px 16px;border-radius:10px;font-weight:500;z-index:60;max-width:calc(100% - 32px)}
.toast[hidden]{display:none}

/* student */
.two{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:20px;align-items:start}
.exam-row{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 20px;border-bottom:1px solid var(--line)}
.exam-row:last-child{border-bottom:0}
.exam-row h3{font-size:16px;font-weight:600}
.meta{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center;margin-top:8px;color:var(--muted);font-size:13px}
.act{display:flex;flex-direction:column;align-items:flex-end;gap:4px;text-align:right}
.score{font-size:20px;font-weight:650;letter-spacing:-.01em}
.check{display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--line)}
.check:last-of-type{border-bottom:0}
.dot{width:10px;height:10px;border-radius:50%;background:var(--line-strong);margin-top:6px;flex:none}
.dot.ok{background:var(--ok)}.dot.warn{background:var(--c3)}.dot.bad{background:var(--bad)}

/* exam overlay */
.exam{position:fixed;inset:0;z-index:30;background:var(--paper);display:flex;flex-direction:column;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.exam-top{display:grid;grid-template-columns:1fr minmax(180px,420px) 1fr;align-items:center;gap:16px;padding:14px 28px;border-bottom:1px solid var(--line);background:var(--surface)}
.exam-top .t{font-weight:600}
.prog{height:6px;border-radius:99px;background:var(--sunken);overflow:hidden;margin-top:6px}
.prog i{display:block;height:100%;background:var(--brand);width:0;transition:width .25s}
.right{display:flex;align-items:center;justify-content:flex-end;gap:16px}
.timer{font-variant-numeric:tabular-nums;font-weight:650;font-size:18px;padding:4px 12px;border-radius:8px;background:var(--sunken)}
.timer.low{background:var(--warn-bg);color:var(--warn)}
.exam-body{flex:1;overflow:auto;padding:36px 20px}
.qwrap{max-width:760px;margin:0 auto}
.qtext{font-size:22px;line-height:1.4;font-weight:600;letter-spacing:-.01em;margin:8px 0 24px}
.opts{display:flex;flex-direction:column;gap:10px}
.opt{display:flex;gap:14px;align-items:flex-start;padding:14px 16px;border:1px solid var(--line-strong);border-radius:10px;background:var(--surface);cursor:pointer}
.opt:hover{border-color:var(--muted)}
.opt input{position:absolute;opacity:0;pointer-events:none}
.opt:focus-within{outline:2px solid var(--brand);outline-offset:2px}
.opt.sel{border-color:var(--brand);background:var(--brand-soft)}
.key{flex:none;width:26px;height:26px;border-radius:7px;background:var(--sunken);display:grid;place-items:center;font-size:13px;font-weight:600}
.opt.sel .key{background:var(--brand);color:var(--brand-ink)}
.exam-foot{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px 28px;border-top:1px solid var(--line);background:var(--surface)}
.done{max-width:520px;margin:12vh auto 0;text-align:center}
.done .ring{width:56px;height:56px;border-radius:50%;background:var(--ok-bg);color:var(--ok);display:grid;place-items:center;margin:0 auto 18px}

/* teacher */
.filters{display:grid;grid-template-columns:minmax(200px,2fr) repeat(3,minmax(130px,1fr));gap:12px;padding:16px 20px;border-bottom:1px solid var(--line)}
.bp{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:20px;align-items:start}
.grid{display:grid;gap:12px}
.g2{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.sec{padding:18px 20px;border-top:1px solid var(--line)}
.sec:first-child{border-top:0}
.sec-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;gap:10px}
.sticky{position:sticky;top:76px}
.stat{display:flex;justify-content:space-between;align-items:baseline;padding:10px 0;border-bottom:1px solid var(--line)}
.stat b{font-size:22px;font-weight:650;letter-spacing:-.01em}
.msg{display:flex;gap:8px;align-items:flex-start;font-size:13px;padding:8px 0}
.msg svg{width:16px;height:16px;flex:none;margin-top:2px}
.msg.ok{color:var(--ok)}.msg.bad{color:var(--bad)}
.drop{border:1.5px dashed var(--line-strong);border-radius:12px;padding:28px;text-align:center;color:var(--muted)}
.drop label{color:var(--ink);font-weight:600;text-decoration:underline;cursor:pointer}
.issues{margin:12px 0 0;padding:0;list-style:none;font-size:13px;max-height:160px;overflow:auto}
.issues li{padding:6px 0;border-bottom:1px solid var(--line)}

/* teacher performance page */
