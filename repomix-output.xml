          <div class="ctrls">
            <button class="switch" id="swCache" role="switch" aria-checked="true"><i></i><span>Cache</span></button>
            <button class="switch" id="swPre" role="switch" aria-checked="true"><i></i><span>Prefetch next questions</span></button>
            <label class="range"><span>Students</span><input type="range" id="rgStud" min="10" max="80" step="5" value="40"><b class="num" id="rgStudV">40</b></label>
            <label class="range"><span>Cache slots</span><select class="select" id="selCap" style="width:96px"><option>50</option><option selected>100</option><option>200</option></select></label>
          </div>
        </div>
        <div class="cols">
          <div class="card pad">
            <h2>Question serve latency, last 60 seconds</h2>
            <svg id="chart" viewBox="0 0 720 240" width="100%" role="img" aria-label="Latency chart" style="margin-top:10px;display:block"></svg>
            <div class="legend"><span><i style="background:var(--c2)"></i>Average</span><span><i style="background:var(--c1)"></i>95th percentile</span></div>
          </div>
          <div class="card pad">
